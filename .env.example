# Local development values only; replace for any shared environment.
POSTGRES_USER=app
POSTGRES_PASSWORD=local-development-password
POSTGRES_DB=orders
DATABASE_URL=postgresql+asyncpg://app:local-development-password@postgres:5432/orders

# Planned Step 4 pool settings, per application process.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=10

SEARCH_PROVIDER=meilisearch
MEILISEARCH_URL=http://meilisearch:7700
MEILISEARCH_MASTER_KEY=local-development-search-key
